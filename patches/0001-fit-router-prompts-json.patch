+def test_main_fit_router_reads_the_prompt_pool_from_json(
+    model: TinyDecoder, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """``--prompts-json`` replaces the WikiText stream, as it already does on
+    ``fit-shard``: the first ``--num-prompts`` of the JSON list reach
+    ``fit_router`` and the streaming loader is never called."""
+    monkeypatch.setattr(jpp_cli, "get_hf_model", lambda name, **_kwargs: model)
+
+    def _no_stream(num_prompts: int) -> list[str]:
+        raise AssertionError("WikiText was streamed despite --prompts-json")
+
+    monkeypatch.setattr(jpp_cli, "load_fit_prompts", _no_stream)
+
+    fitted_on: list[list[str]] = []
+    stream_free_fit_router = jpp_cli.fit_router
+
+    def _recording_fit_router(model_arg, prompts, **kwargs):
+        fitted_on.append(list(prompts))
+        return stream_free_fit_router(model_arg, prompts, **kwargs)
+
+    monkeypatch.setattr(jpp_cli, "fit_router", _recording_fit_router)
+
+    pool_path = tmp_path / "pool.json"
+    pool_path.write_text(json.dumps([*PROMPTS, "zyxwvutsrq " * 5]))
+    router_path = tmp_path / "router.pt"
+
+    assert (
+        main(
+            [
+                "fit-router",
+                "--hf-model-name",
+                "tiny",
+                "--layers",
+                "0,1,2",
+                "--prompts-json",
+                str(pool_path),
+                "--num-prompts",
+                str(len(PROMPTS)),
+                "--num-clusters",
+                str(NUM_CLUSTERS),
+                "--projection-dim",
+                str(PROJECTION_DIM),
+                "--max-seq-len",
+                str(MAX_SEQ_LEN),
+                "--out",
+                str(router_path),
+            ]
+        )
+        == 0
+    )
+    assert fitted_on == [list(PROMPTS)]
+    assert ActivationRouterCollection.load(str(router_path)).num_clusters == NUM_CLUSTERS
+
+
+def test_fit_router_without_prompts_json_still_streams_wikitext(
+    model: TinyDecoder, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """The flag is optional: with it absent the stage keeps its old behaviour."""
+    monkeypatch.setattr(jpp_cli, "get_hf_model", lambda name, **_kwargs: model)
+    streamed: list[int] = []
+
+    def _stream(num_prompts: int) -> list[str]:
+        streamed.append(num_prompts)
+        return list(PROMPTS)
+
+    monkeypatch.setattr(jpp_cli, "load_fit_prompts", _stream)
+
+    assert (
+        main(
+            [
+                "fit-router",
+                "--hf-model-name",
+                "tiny",
+                "--layers",
+                "0,1,2",
+                "--num-prompts",
+                "4",
+                "--num-clusters",
+                str(NUM_CLUSTERS),
+                "--projection-dim",
+                str(PROJECTION_DIM),
+                "--max-seq-len",
+                str(MAX_SEQ_LEN),
+                "--out",
+                str(tmp_path / "router.pt"),
+            ]
+        )
+        == 0
+    )
+    assert streamed == [4]
+
+
